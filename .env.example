# test51 speed-run — Docker defaults (copy to .env).
# Host env / compose environment win over this file inside the binary.

# all four dense recipes, one after another
SPEED_LAYER=all
SPEED_MODES=all
SPEED_FULL=true

# Keep low on Mac Mini — high workers caused goroutine/OOM crashes.
SPEED_WORKERS=4

SPEED_CKPT_ROOT=speed_ckpt
SPEED_ADDR=0.0.0.0:5151
SPEED_TIDE_ADDR=0.0.0.0:8080
SPEED_AUTOSTART=true
SPEED_RESUME=true

# Soft GC pressure inside the container (compose also sets these).
GOMEMLIMIT=6GiB
GOGC=50
